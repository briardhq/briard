#!/etc/briard/tools/bin/bash
# The one escalation, the same cell in both topologies: a demote DRBD refused, or an unmount
# something still holds open. Nothing else recovers a node stuck holding a volume it has declared
# it cannot serve -- on a flock the peer cannot take over, alone the restart would mount on top of
# it. Whoever attempts the demote owns what happens when DRBD refuses it: the unit's
# FailureAction=reboot.
#
# The topology word decides (node storage writes it). A missing word means "node storage has not
# run on this boot" and an unknown one names itself rather than guessing. Both fail the step, and
# what that means is the unit's to say (ExecCondition skips, ExecStartPre escalates).
set -u
if [ ! -r /run/briard/topology.env ]; then
  echo "briard-hold-confirm: no /run/briard/topology.env; node storage has not run on this boot" >&2
  exit 1
fi
. /run/briard/topology.env
case "${BRIARD_TOPOLOGY:-}" in
  flock) /etc/briard/tools/lib/drbd/scripts/drbd-service-shim.sh secondary-or-escalate r0 ;;
  alone) ! mountpoint -q /var/lib/briard || umount /var/lib/briard ;;
  *)
    echo "briard-hold-confirm: /run/briard/topology.env says '$BRIARD_TOPOLOGY', which is neither flock nor alone" >&2
    exit 1
    ;;
esac
