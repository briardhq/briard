#!/etc/briard/tools/bin/bash
# Alone, the restart is ours: no reactor re-promotes, so the hold starts the chain it stopped --
# hold-and-restart, forever, no reboot, as a flock does through its reactor. `--no-block`: this
# runs inside the hold's own stop, and the start must not wait on it. The target is `$1`, from
# the agent, for the same reason the stop list is.
#
# The topology word decides (node storage writes it). A missing word means "node storage has not
# run on this boot" and an unknown one names itself rather than guessing. Both fail the step, and
# what that means is the unit's to say (ExecCondition skips, ExecStartPre escalates).
set -u
if [ ! -r /run/briard/topology.env ]; then
  echo "briard-hold-restart: no /run/briard/topology.env; node storage has not run on this boot" >&2
  exit 1
fi
. /run/briard/topology.env
case "${BRIARD_TOPOLOGY:-}" in
  flock) : ;;
  alone) systemctl start --no-block "$1" ;;
  *)
    echo "briard-hold-restart: /run/briard/topology.env says '$BRIARD_TOPOLOGY', which is neither flock nor alone" >&2
    exit 1
    ;;
esac
