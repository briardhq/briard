#!/bin/sh
# briard-update: converge this node to the release channel.
#
# SHIPPED VERBATIM and FROZEN: a signed artifact of the host chain that install.sh copies
# into place, never a heredoc. The freeze is the safety property -- this is dumb, agent-INDEPENDENT
# shell, so a bug in the volatile agent can never wedge the thing that replaces it -- and it is
# frozen by necessity: it launches the replacement of the binary, so no release can be what
# fixes it. What shipping adds is that the file is versioned, diffable and covered by the release
# signature.
#
# ⚠️ IT HAS NO PRODUCT KNOWLEDGE, and that is the whole design: four steps -- read the channel and
# keyring, read the target, download the pointer's agent, run it with --update -- and the verdict
# written down. The fetched binary does the whole update (stop, swap, start, commit or revert), so
# nothing in the product can make this script need a new release.
set -eu

# The node's own configuration, when it has one. The unit delivers it as an EnvironmentFile, so
# what lands here is CHANNEL_URL and UPDATE_KEYRING exactly as the operator set them at install.
#
# ⚠️ THE TWO DEFAULTS BELOW ARE A DELIBERATE SECOND COPY of agent/host/config.go's (owner's call).
# config.env carries a key only when somebody named one, so on an ordinary install there
# is nothing here to read -- and this script must not ask the agent, which is the thing it exists
# to replace. Two literals, pinned by a test that reads both files.
CHANNEL="${CHANNEL_URL:-https://get.briard.io}"
KEYRING="${UPDATE_KEYRING:-/opt/briard/keyring.pem}"
BASE=/opt/briard/agent
RUN=/run/briard
mkdir -p "$RUN"
# The verdict: `ok <line>` or `failed <line>`, left for `briard update` and the agent's update
# alerter, and the line itself on stdout for the journal.
report() { printf '%s %s\n' "$1" "$2" > "$RUN/update-result"; printf '%s\n' "$2"; }
# (1) The target, as a message: stable | latest | an exact id. Absent means stable.
target=stable
if [ -f "$RUN/update-target" ]; then
	target=$(head -n1 "$RUN/update-target")
	rm -f "$RUN/update-target"
fi
# (2) A fresh agent FROM THE TARGET runs the update. Under $BASE, not /run: Debian mounts /run
#     noexec; and never the committed binary, which the update replaces.
tmp=$(mktemp -d "$BASE/.update.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
url="$CHANNEL/briard/$target/linux-amd64/briard-agent"
if command -v curl >/dev/null 2>&1; then curl -fsSL "$url" -o "$tmp/briard-agent"
elif command -v wget >/dev/null 2>&1; then wget -qO "$tmp/briard-agent" "$url"
else report failed "need curl or wget to fetch $url"; exit 1; fi || { report failed "could not fetch a bootstrap agent from $url"; exit 1; }
chmod +x "$tmp/briard-agent"
# (3) Its log goes to the journal as it happens (stderr); its last stdout line is the verdict.
set +e
BRIARD_CHANNEL_URL="$CHANNEL" BRIARD_KEYRING="$KEYRING" UPDATE_BASE="$BASE" UPDATE_RUN_DIR="$RUN" \
	"$tmp/briard-agent" --update "$target" > "$tmp/out"
rc=$?
set -e
line=$(tail -n1 "$tmp/out")
if [ "$rc" -eq 0 ]; then report ok "$line"; else report failed "${line:-the update exited $rc with no verdict}"; fi
exit $rc
