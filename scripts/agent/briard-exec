#!/bin/sh
# briard-exec: pick the binary this boot runs -- a staged candidate if one is armed, else the
# committed one. The ExecStart of briard-agent.service, and half of self-update's on-disk pivot
# ([B.84]); briard-commit beside it is the other half. Change one and change both.
#
# SHIPPED VERBATIM and FROZEN ([B.157]): a signed artifact of the host chain that install.sh copies
# into place. FROZEN is the safety property -- dumb, agent-INDEPENDENT shell, so a bug in the
# volatile agent can never wedge the mechanism that replaces it -- and shipping does not touch it.
# What it adds is that the file is versioned, diffable and covered by the release signature.
#
# THE LOGIC IS PROVEN TWICE: nixosTest/agent-selfupdate.nix drives the same shape over a rig's own
# paths (every failure mode: crash, hang, tamper, power loss), and install-macvtap.nix drives THESE
# FILES on a real install. Change one and change both.
#
# `run` is the daemon subcommand: a bare invocation prints the help ([V3b.23]), so this line and
# the unit are what start an agent.
set -eu
if [ -e /run/briard/update ]; then
	mv /run/briard/update /run/briard/trial        # consume SINGLE-USE (rename, not delete): a
	exec /opt/briard/agent/briard-agent.next run   #   crash cannot re-trial forever, and
else                                               #   briard-commit can still tell a trial boot
	rm -f /run/briard/trial                        #   from a normal one. Discarding the marker
	                                               #   IS the revert.
	# A NON-TRIAL START WITH STAGED FILES PRESENT IS THE AFTERMATH OF A FAILED TRIAL, and the
	# invariant is that staged files exist only between a stage and its verdict -- so discard them.
	# The guest picker has said exactly this since [B.148]; the host said nothing and left a dead
	# candidate on disk until the next fetch happened to overwrite it.
	#
	# It also clears the set an arm could not survive to trial: the arm lives in /run, so a reboot
	# before the agent's own safe point loses the flag and strands the files it pointed at.
	rm -f /opt/briard/agent/briard-agent.next /opt/briard/agent/manifest.json.next \
		/opt/briard/agent/briard-net-wrap.next /opt/briard/agent/qemu.next \
		/opt/briard/agent/guest.next
	# ⚠️ AND THE ARM, IF ONE APPEARED WHILE WE WERE DELETING. The window is narrow -- a fetch has to
	# stage AND arm between the test above and the removals -- but the outcome without this line is
	# the worst state the pivot has: the next boot trials a set we gutted, briard-commit accepts a
	# PARTIAL bundle (new agent, old qemu tree), and the single-use flag is already spent, so there
	# is nothing left to revert and the node needs a reinstall. Dropping a fresh stage costs a day
	# (the timer re-runs, and `briard update host` is always there) and cannot do that.
	rm -f /run/briard/update
	exec /opt/briard/agent/briard-agent run
fi
